{
  "title": "ProcureFlow",
  "subtitle": "B2B procurement platform",
  "description": "A full-stack platform for company discovery, RFQs, quotation comparison and purchase-order tracking, with organization-scoped access and responsive client/company workspaces.",
  "liveUrl": "https://procureflow-anonymnd.vercel.app",
  "sourceUrl": "https://github.com/anonymnd/procureflow-ai/tree/codex/fsb-demo-production",
  "caseStudyUrl": "https://github.com/anonymnd/procureflow-ai/blob/codex/portfolio-assets/docs/portfolio/README.md",
  "stack": [
    "Java 17",
    "Spring Boot 4.1.1",
    "React 19",
    "Vite 8",
    "PostgreSQL",
    "Spring Data JPA",
    "Spring Security",
    "Flyway",
    "Docker",
    "Vercel",
    "Render"
  ],
  "architecture": "Feature-oriented modular monolith with controller/service/repository layers and a separate frontend deployment",
  "modules": [
    "Identity and organization access",
    "Marketplace and company publishing",
    "Procurement: RFQs, quotations, awards, orders, queues and analytics"
  ],
  "patterns": [
    "Repository",
    "Service Layer",
    "DTO",
    "Constructor Dependency Injection",
    "Explicit State Transitions",
    "Order Snapshots",
    "Idempotent Commands",
    "Centralized Exception Handling"
  ],
  "methodology": "Adapted lightweight Agile V: iterative vertical slices, requirement-to-test traceability, frozen baselines, GitHub issues, scoped gates, separate-context review and hosted verification",
  "principles": [
    "YAGNI",
    "KISS",
    "Separation of concerns",
    "Authorization at trust boundaries"
  ],
  "limits": [
    "Free backend cold starts",
    "Fresh email delivery verification deferred",
    "AI drafting/extraction/scoring not delivered",
    "Direct Render static fallback has preceding UI"
  ],
